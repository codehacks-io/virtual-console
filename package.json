{
    "name": "@codehacks/virtual-console",
    "version": "0.4.0",
    "description": "A bullet-proof virtual console for mobile debugging and error catching",
    "type": "module",
    "sideEffects": [
        "./dist/plugin/client.js",
        "./dist/runtime/styles.css",
        "./dist/runtime/styles/**"
    ],
    "main": "./dist/runtime/index.cjs",
    "module": "./dist/runtime/index.js",
    "types": "./dist/runtime/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js",
            "require": "./dist/runtime/index.cjs"
        },
        "./plugins/vite": {
            "types": "./dist/plugin/index.d.ts",
            "import": "./dist/plugin/index.js",
            "require": "./dist/plugin/index.cjs"
        },
        "./plugins/vite/client": {
            "types": "./dist/plugin/client.d.ts",
            "import": "./dist/plugin/client.js"
        },
        "./styles.css": {
            "default": "./dist/runtime/styles.css"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsup --watch --onSuccess \"mkdir -p dist/runtime/styles && cp -r src/runtime/styles/* dist/runtime/styles/ && cp src/runtime/styles.css dist/runtime/styles.css\"",
        "build": "rm -rf dist && tsup && mkdir -p dist/runtime/styles && cp -r src/runtime/styles/* dist/runtime/styles/ && cp src/runtime/styles.css dist/runtime/styles.css",

        "dev:import:local": "pnpm build && pnpm --parallel --filter @codehacks/virtual-console --filter @codehacks/react-vite-local-import dev",
        "dev:import:published": "pnpm run install:import:published && pnpm --dir examples/published/react-vite-import dev",
        "dev:vite-plugin:local": "pnpm build && pnpm --parallel --filter @codehacks/virtual-console --filter @codehacks/react-vite-local-plugin dev",
        "dev:vite-plugin:published": "pnpm run install:vite-plugin:published && pnpm --dir examples/published/react-vite-plugin dev",

        "build:import:local": "pnpm build && pnpm --filter @codehacks/react-vite-local-import build",
        "build:import:published": "pnpm run install:import:published && pnpm --dir examples/published/react-vite-import build",
        "build:vite-plugin:local": "pnpm build && pnpm --filter @codehacks/react-vite-local-plugin build",
        "build:vite-plugin:published": "pnpm run install:vite-plugin:published && pnpm --dir examples/published/react-vite-plugin build",
        "build:local": "pnpm run build:import:local && pnpm run build:vite-plugin:local",
        "build:published": "pnpm run build:import:published && pnpm run build:vite-plugin:published",

        "install:import:published": "pnpm --dir examples/published/react-vite-import install",
        "install:vite-plugin:published": "pnpm --dir examples/published/react-vite-plugin install",
        "install:published": "pnpm run install:import:published && pnpm run install:vite-plugin:published",

        "lint": "oxlint .",
        "lint:fix": "oxlint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
        "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "vite",
        "plugin",
        "console",
        "debug",
        "mobile",
        "eruda",
        "vconsole"
    ],
    "author": "codehacks-io",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codehacks-io/virtual-console.git"
    },
    "homepage": "https://github.com/codehacks-io/virtual-console#readme",
    "bugs": {
        "url": "https://github.com/codehacks-io/virtual-console/issues"
    },
    "engines": {
        "node": ">=26"
    },
    "peerDependencies": {
        "vite": ">=5.0.0 <9.0.0"
    },
    "peerDependenciesMeta": {
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^26.3.0",
        "jsdom": "^30.0.1",
        "oxlint": "^1.80.0",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11"
    },
    "publishConfig": {
        "access": "public"
    }
}