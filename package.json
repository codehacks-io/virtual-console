{
    "name": "@codehacks-io/virtual-console",
    "version": "0.0.0-rc.1",
    "description": "A bullet-proof virtual console for mobile debugging and error catching",
    "type": "module",
    "main": "./dist/plugin/index.cjs",
    "module": "./dist/plugin/index.js",
    "types": "./dist/plugin/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/plugin/index.d.ts",
            "import": "./dist/plugin/index.js",
            "require": "./dist/plugin/index.cjs"
        },
        "./vite": {
            "types": "./dist/plugin/index.d.ts",
            "import": "./dist/plugin/index.js",
            "require": "./dist/plugin/index.cjs"
        },
        "./runtime": {
            "types": "./dist/runtime/core.d.ts",
            "import": "./dist/runtime/core.iife.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "pnpm --filter playground dev",
        "build": "tsup && cp -r src/runtime/styles dist/runtime/styles",
        "lint": "tsc --noEmit",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "vite",
        "plugin",
        "console",
        "debug",
        "mobile",
        "eruda",
        "vconsole"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.2",
        "vite": "^5.0.0"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    }
}