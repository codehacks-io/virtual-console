{
    "name": "@codehacks/virtual-console",
    "version": "0.0.1-alpha.1",
    "description": "A bullet-proof virtual console for mobile debugging and error catching",
    "type": "module",
    "main": "./dist/runtime/index.cjs",
    "module": "./dist/runtime/index.js",
    "types": "./dist/runtime/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/runtime/index.d.ts",
            "import": "./dist/runtime/index.js",
            "require": "./dist/runtime/index.cjs"
        },
        "./plugins/vite": {
            "types": "./dist/plugin/index.d.ts",
            "import": "./dist/plugin/index.js",
            "require": "./dist/plugin/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "pnpm --filter playground dev",
        "build": "tsup && mkdir -p dist/runtime/styles && cp -r src/runtime/styles/* dist/runtime/styles/",
        "lint": "tsc --noEmit",
        "prepublishOnly": "pnpm build"
    },
    "keywords": [
        "vite",
        "plugin",
        "console",
        "debug",
        "mobile",
        "eruda",
        "vconsole"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@types/node": "^20.10.0",
        "tsup": "^8.0.1",
        "typescript": "^5.3.2",
        "vite": "^5.0.0"
    },
    "publishConfig": {
        "access": "public"
    }
}